# Segredos de SERVIDOR das Edge Functions do Atlas Agenda — COPIE para supabase/functions/.env
# (ou configure como secrets do Supabase) e preencha. NUNCA versionar o arquivo preenchido.
#
# ATENÇÃO DE SEGURANÇA: estes valores vivem SÓ no servidor (Edge Functions / secrets do
# Supabase). NUNCA use o prefixo VITE_ aqui — qualquer VITE_* é embutido no bundle público do
# navegador. Token/URL da Evolution e service role key JAMAIS podem chegar ao cliente.
#
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são injetadas automaticamente pelo runtime das Edge
# Functions do Supabase; não precisam ser definidas aqui em produção.

# Modo do adapter Evolution: `mock` (default desta fase, sem rede) ou `real` (fase futura).
EVOLUTION_MODE=mock

# URL base da Evolution API — lida SÓ pela impl `real` (fase futura). Sem valor nesta fase.
EVOLUTION_API_URL=

# Token/API key da Evolution — lida SÓ pela impl `real` (fase futura). Sem valor nesta fase.
EVOLUTION_API_KEY=

# Segredo compartilhado do WEBHOOK DE ENTRADA da Evolution (ADR-03, Fatia 2). A função
# `whatsapp-inbound` é pública (sem JWT) e verifica autenticidade comparando este valor — em
# tempo constante — com o segredo apresentado pela Evolution no header `x-webhook-secret`/`apikey`
# ou no query param `?token=` da URL de webhook registrada na instância. A Evolution v2.3.x não
# assina HMAC por padrão, daí o segredo compartilhado. Gere um valor longo e aleatório; vive SÓ no
# servidor/secret, NUNCA no bundle, NUNCA com prefixo VITE_. Sem este valor, o webhook recusa tudo
# (falha fechada, 401).
WHATSAPP_WEBHOOK_SECRET=
# Segredo de assinatura do hook `custom_access_token` (ADR-01). Formato `v1,whsec_<base64>`, gerado
# pelo painel do Supabase para o hook (hosted) ou escolhido para o stack local. O mesmo valor
# precisa estar no ambiente do GoTrue (`[auth.hook.custom_access_token] secrets`). Sem ele, a
# função recusa todo login (falha fechada, 500 identity_unavailable). Nunca VITE_*.
CUSTOM_ACCESS_TOKEN_HOOK_SECRET=

# Bootstrap do super admin inicial (ADR-05). `ATLAS_ENV=local` é a trava da função
# `bootstrap-super-admin`: com valor diferente de `local` (ou ausente), ela recusa com 403
# `ambiente_nao_local`, mesmo com o segredo certo. Valores possíveis nesta fase: `local`.
ATLAS_ENV=local

# Segredo do header `x-bootstrap-secret`, comparado em tempo constante (SHA-256 + XOR) dentro da
# função pública `bootstrap-super-admin`. Gere um valor longo e aleatório e REMOVA este segredo
# depois do uso do bootstrap (P-04). Sem valor definido, a função responde 404 e parece não
# existir. Vive SÓ no servidor, nunca no bundle, nunca com prefixo VITE_.
BOOTSTRAP_SECRET=

# Exceção explícita do operador para rodar o bootstrap fora do ambiente local. Só o literal `true`
# libera, e apenas no ambiente de destino autorizado. Não usar nesta entrega.
# BOOTSTRAP_ALLOW_NON_LOCAL=true

# Asaas master key para criptografia de API keys (ADR-20). Obrigatório; função falha fechada se ausente/vazio.
ASAAS_MASTER_KEY=

# Token de webhook Asaas (cobrança de agendamento) comparado em tempo constante com header asaas-access-token.
ASAAS_WEBHOOK_TOKEN=

# Token de webhook Asaas (assinatura) — fallback para ASAAS_WEBHOOK_TOKEN se ausente.
ASAAS_SUBSCRIPTION_WEBHOOK_TOKEN=

# Credenciais Asaas do super admin (assinaturas). `ASAAS_SUPER_ADMIN_ENVIRONMENT` é
# obrigatória e sem default: `sandbox` ou `production`, explícita por ambiente.
ASAAS_SUPER_ADMIN_API_KEY=
ASAAS_SUPER_ADMIN_ENVIRONMENT=sandbox
