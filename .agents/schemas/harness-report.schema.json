{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schemas/harness-report.schema.json",
  "title": "harness-report",
  "description": "Self-reported execution evidence (harness/<demand>.json). Auto-declared by the executor (SPEC ADR-002: selfReported); proof comes from the gate re-running the sealed canonical command (contraprova). Field set = SPEC §5.2.",
  "type": "object",
  "required": [
    "version",
    "demand",
    "agent",
    "phase",
    "gitSha",
    "commands",
    "counts",
    "evaluation",
    "brainStore",
    "cleanup",
    "selfReported"
  ],
  "properties": {
    "version": { "type": "integer", "description": "schema version" },
    "demand": { "type": "string", "description": "demand identifier" },
    "agent": { "type": "string", "description": "executing agent" },
    "phase": { "type": "string", "description": "workflow phase" },
    "gitSha": { "type": "string", "description": "contraprova cache key" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["cmd", "exitCode", "durationMs", "stdoutHash"],
        "properties": {
          "cmd": { "type": "string" },
          "exitCode": { "type": "integer" },
          "durationMs": { "type": "number" },
          "stdoutHash": { "type": "string" }
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["unit", "it", "frontend"],
      "properties": {
        "unit": { "$ref": "#/$defs/testCounts" },
        "it": { "$ref": "#/$defs/testCounts" },
        "frontend": { "$ref": "#/$defs/testCounts" }
      }
    },
    "e2e": {
      "type": "object",
      "description": "conditional: required when escalateOnRisk fires or e2eGreenfield evidence is declared"
    },
    "evaluation": {
      "type": "object",
      "description": "H4: telas/negocio/logica/perf"
    },
    "brainStore": {
      "type": "array",
      "description": "saved brain paths"
    },
    "cleanup": {
      "type": "object",
      "description": "freed ports/processes"
    },
    "selfReported": {
      "type": "boolean",
      "description": "true when the exit code was not independently observed"
    }
  },
  "$defs": {
    "testCounts": {
      "type": "object",
      "required": ["passed", "failed", "skipped"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
