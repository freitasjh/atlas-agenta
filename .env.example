# Variáveis de ambiente do Atlas Agenda (frontend) — COPIE para .env e preencha.
#
# ATENÇÃO DE SEGURANÇA: tudo que começa com VITE_ é EMBUTIDO no bundle público
# enviado ao navegador. Portanto, só coloque aqui segredos PÚBLICOS.
# NUNCA coloque a service role key do Supabase, a chave do Asaas, o token da
# Evolution API ou qualquer segredo de webhook em variáveis VITE_*: eles ficariam
# expostos no cliente. Esses segredos vivem só em Edge Functions / env do Supabase.

# URL do projeto Supabase.
VITE_SUPABASE_URL=

# Chave ANÔNIMA (pública) do Supabase — a única chave que pode ir ao cliente.
VITE_SUPABASE_ANON_KEY=
